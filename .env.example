# KAJ App — Environment Variables
# Copy this file to .env and fill in your values.

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
# Second model: used when the main model is overloaded or out of quota, and for the "too many flags" retry
GEMINI_FALLBACK_MODEL=

# --- Firebase (Server-side admin SDK) ---
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="your_private_key"

# --- Firebase (Client-side, exposed to browser via VITE_ prefix) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Tenant ---
# Default tenant ID for the demo / single-tenant setup
TENANT_ID=das-cooling-services
